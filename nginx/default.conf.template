server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # --- Protection optionnelle (décommentez + montez un fichier .htpasswd) ---
    # auth_basic "TMM Remote";
    # auth_basic_user_file /etc/nginx/.htpasswd;

    # Proxy vers l'API de tinyMediaManager : ajoute la clé côté serveur
    # (elle n'est jamais envoyée au navigateur) et évite les soucis de CORS.
    location /api/ {
        proxy_pass http://${TMM_HOST}/api/;
        proxy_set_header api-key "${TMM_API_KEY}";
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        client_max_body_size 1m;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
